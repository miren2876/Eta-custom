+
+    private lateinit var scaleDetector: ScaleGestureDetector
+    private var curWidthDp = 0
+    private var curHeightDp = 0
+    private val minWidthDp = 72
+
+    /** 常规大小档：内容短边 200dp，够手指点按，又不占满屏。 */
+    private val NORMAL_INNER_DP = 200f
+

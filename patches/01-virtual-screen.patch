+    /** 查看页退出后把小窗接回来。 */
+    fun resumeAfterViewer() {
+        if (!viewerSuppressed) return
+        viewerSuppressed = false
+        val next = VirtualScreenSession.state.value.display ?: return
+        scope.launch {
+            val settings = runCatching { SettingsDataStore.settings() }.getOrNull() ?: return@launch
+            runCatching { show(next, settings) }
+        }
+    }

+    /** 查看页全屏时收起小窗：直通输出面只有一个，两个预览同时开着必有一个是黑框。 */
+    fun suspendForViewer() {
+        if (viewerSuppressed) return
+        viewerSuppressed = true
+        hide()
+    }

+    private fun startTiltWatcher() {
+        // v30: float window orientation follows virtual display content, not phone tilt
+    }
+
+    private fun stopTiltWatcher() {
+        sensorManager?.let { runCatching { it.unregisterListener(tiltListener) } }
+        sensorManager = null
+        tiltHoldSince = 0L
+    }

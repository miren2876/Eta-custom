+        if (collapsed || display.width <= 0 || display.height <= 0) return
+        val wantLandscape = display.width > display.height
+        if (wantLandscape != (curWidthDp >= curHeightDp)) {
+            val tmp = curWidthDp; curWidthDp = curHeightDp; curHeightDp = tmp
+            innerShortDp = 0f
+        }
+        alignToContent()
+        normalizeSize()
+        applySize()
+        clampToScreen()
+    }

+    /** 内容区短边（dp）。横竖屏切换时保持不变，只换比例，保证两种朝向的小窗“大小手感”一致。 */
+    private var innerShortDp = 0f
+    private var edgeCollapseEnabled = true
+    private var windowAlpha = 0.85f

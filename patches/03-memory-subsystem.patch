+            val haystack = line.lowercase()
+            val normalizedLine = normalize(line)
+            var score = 0.0
+            var hits = 0
+            tokens.forEach { token ->
+                val occurrences = countOccurrences(haystack, token)
+                if (occurrences > 0) {
+                    hits++
+                    score += token.length.coerceAtMost(6) * (1.0 + ln(1.0 + occurrences))
+                }
+            }
+            if (score > 0.0) {

+    private val WORD = Regex("[\\p{L}\\p{N}]+")
+    private val CJK = Regex("[\\p{IsHan}\\p{IsHiragana}\\p{IsKatakana}\\p{IsHangul}]")
+    private val HEADING = Regex("^(#{1,6})\\s+(.+)$")
+    private val PUNCTUATION = Regex("[\\s\\p{Punct}·、。，！？；：（）「」『』【】《》—…]+")

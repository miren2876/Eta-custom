+ */
+internal fun conversationTopBarTitle(
+    title: String,
+    maxChars: Int = CONVERSATION_TITLE_MAX_CHARS,
+): String {
+    val trimmed = title.trim()
+    val limit = maxChars.coerceAtLeast(1)
+    if (trimmed.length <= limit) return trimmed
+    return trimmed.take(limit - 1) + "…"
+}
